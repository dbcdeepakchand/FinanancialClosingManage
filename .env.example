# Copy this file to .env and set values for your Oracle database.
DB_USER=your_database_username
DB_PASSWORD=your_database_password
# Use the connect string supplied by your Oracle DBA, e.g. host:1521/service_name.
DB_CONNECT_STRING=your_host:1521/your_service_name

# For an Autonomous Database wallet, set the wallet directory and wallet password.
# DB_WALLET_LOCATION=C:\path\to\wallet
# DB_WALLET_PASSWORD=your_wallet_password

# Keep the API on loopback unless it is protected by an authenticated reverse proxy.
HOST=127.0.0.1
PORT=3001
